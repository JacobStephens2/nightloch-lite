terraform {
  required_version = ">= 1.6.0"

  required_providers {
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.50"
    }
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 4.40"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "digitalocean" {
  # DIGITALOCEAN_TOKEN
}

provider "cloudflare" {
  # CLOUDFLARE_API_TOKEN with Zone.DNS Edit (+ Zone Read)
}
