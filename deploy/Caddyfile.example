# Staging (Slice 1 Path A). Stock Caddy HTTP-01.
# Keep root at .../public only — never serve /opt/nightloch (SQLite/binary).
lite.nightloch.app {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		# Overwrite rather than append so the app's per-IP rate limit cannot be
		# bypassed with a forged inbound X-Forwarded-For value.
		header_up X-Forwarded-For {remote_host}
	}
}

# Resolver administration is a separate site artifact so the posture installer
# can own it without rewriting this control-plane site.  The glob may be empty
# before Slice 4 is installed.
import /etc/caddy/sites/*.caddy
