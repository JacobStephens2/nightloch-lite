[Unit]
Description=Nightloch Resolver (AdGuard Home)
Wants=network-online.target
Requires=wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service
ConditionPathExists=/etc/AdGuardHome/AdGuardHome.yaml

[Service]
Type=simple
User=adguardhome
Group=adguardhome
WorkingDirectory=/var/lib/AdGuardHome
ExecStart=/opt/AdGuardHome/AdGuardHome --no-check-update --config /etc/AdGuardHome/AdGuardHome.yaml --work-dir /var/lib/AdGuardHome
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=512M
UMask=0077

# DNS needs one privileged port and nothing else privileged.  AdGuard Home may
# update its own persisted config and filter/query-log data, but not the host.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ConfigurationDirectory=AdGuardHome
ConfigurationDirectoryMode=0750
StateDirectory=AdGuardHome
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
