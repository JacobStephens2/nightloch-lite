#!/bin/sh
#
# nightloch-wg — the privileged root helper for tunnel membership.
#
# Install at /usr/local/sbin/nightloch-wg, owned by root, mode 0755, alongside
# the grant in nightloch-wg.sudoers. Why the tunnel is reached this way, and
# what bounds the escalation:
# docs/adr/0004-reach-the-tunnel-through-a-root-helper.md
#
# It exposes exactly three subcommands and refuses everything else:
#
#   add-peer <public-key> <address>   add a Device to the tunnel
#   remove-peer <public-key>          remove a Device from the tunnel
#   show                              report peer and handshake state
#
# Every argument is validated against its expected shape before any command is
# invoked and before any file is written, so a refusal has no side effect.
#
# A membership change is rendered into the interface configuration first and
# only then applied to the running interface, so a reboot does not silently drop
# minted Devices. The order matters: rendering can fail on a configuration this
# helper does not recognise, and failing before `wg set` leaves the interface
# and its configuration agreeing rather than drifting apart. The rendered file
# is moved into place only after the interface accepts the change, so a refused
# `wg set` leaves the configuration byte-for-byte as it was.
#
# `show` reports one line per peer: public key, allowed IPs, and the latest
# handshake as a Unix timestamp, tab separated. It deliberately does not pass
# `wg show ... dump` through: that output leads with the interface's own private
# key, and the unprivileged caller must never be handed the server's identity.
#
# Exit codes: 0 success, 2 refusal (unknown subcommand or malformed argument),
# 3 the tunnel is not in a state the operation can be performed against, and
# whatever wg reported otherwise. Absence of the helper is the shell's 127, so a
# caller can tell a missing helper from a refusal.
#
# NIGHTLOCH_WG_INTERFACE and NIGHTLOCH_WG_CONFIG exist so the tests can run this
# script against a scratch interface configuration. Under sudo they are not a
# surface: the shipped grant sets env_reset and its own secure_path, so neither
# these variables nor PATH cross the boundary from the caller.

set -eu
umask 077

interface="${NIGHTLOCH_WG_INTERFACE:-wg0}"
config="${NIGHTLOCH_WG_CONFIG:-/etc/wireguard/wg0.conf}"

# The tunnel network from the security design: 10.66.0.0/24 with the host
# permanently at 10.66.0.1. Allocation is the application's job; refusing an
# address outside the range is this script keeping its own surface closed.
network_prefix="10.66.0."
first_device_octet=2
last_device_octet=254

usage() {
	cat >&2 <<'USAGE'
usage: nightloch-wg add-peer <public-key> <address>
       nightloch-wg remove-peer <public-key>
       nightloch-wg show
USAGE
}

# refuse reports a closed door: the input was not something this helper accepts,
# and nothing has been invoked or written.
refuse() {
	printf 'nightloch-wg: %s\n' "$1" >&2
	usage
	exit 2
}

# unavailable reports that the tunnel is not in a state this operation can be
# performed against. Distinct from a refusal so a caller can tell an operator
# mistake from a plane that is down.
unavailable() {
	printf 'nightloch-wg: %s\n' "$1" >&2
	exit 3
}

# trim strips leading and trailing blanks into the global `trimmed`, so a
# section header or directive is recognised however the file is indented.
trim() {
	trimmed="$1"
	while :; do
		case "$trimmed" in
		' '* | '	'*) trimmed="${trimmed#?}" ;;
		*' ' | *'	') trimmed="${trimmed%?}" ;;
		*) break ;;
		esac
	done
}

# validate_public_key accepts only a WireGuard base64 key: 43 characters from
# the base64 alphabet followed by a single trailing pad.
validate_public_key() {
	key="$1"
	if [ ${#key} -ne 44 ]; then
		refuse "malformed public key"
	fi
	case "$key" in
	*[!A-Za-z0-9+/=]*) refuse "malformed public key" ;;
	esac
	case "$key" in
	*=) ;;
	*) refuse "malformed public key" ;;
	esac
	case "${key%?}" in
	*=*) refuse "malformed public key" ;;
	esac
}

# validate_address accepts only a bare IPv4 address inside the tunnel network
# and assignable to a Device. The host, network, and broadcast addresses are
# refused, as is any prefix length: a Device holds exactly one address.
validate_address() {
	address="$1"
	case "$address" in
	"$network_prefix"*) ;;
	*) refuse "address outside the tunnel network" ;;
	esac
	octet="${address#"$network_prefix"}"
	case "$octet" in
	'' | *[!0-9]*) refuse "malformed address" ;;
	esac
	if [ ${#octet} -gt 3 ]; then
		refuse "malformed address"
	fi
	case "$octet" in
	0?*) refuse "malformed address" ;;
	esac
	if [ "$octet" -lt "$first_device_octet" ] || [ "$octet" -gt "$last_device_octet" ]; then
		refuse "address outside the assignable range"
	fi
}

# require_config runs before the interface is touched. A configuration this
# helper cannot recognise is refused rather than rewritten: replacing a file
# whose interface section was not understood would leave the tunnel unable to
# come back up at all, which is worse than dropping a Device.
require_config() {
	if [ ! -f "$config" ]; then
		unavailable "interface configuration $config is missing"
	fi
	if [ ! -w "$config" ]; then
		unavailable "interface configuration $config is not writable"
	fi
	while IFS= read -r line || [ -n "$line" ]; do
		trim "$line"
		if [ "$trimmed" = "[Interface]" ]; then
			return 0
		fi
	done <"$config"
	unavailable "interface configuration $config has no [Interface] section"
}

require_interface() {
	if ! ip link show dev "$interface" >/dev/null 2>&1; then
		unavailable "tunnel interface $interface is not present"
	fi
}

# render_config writes the whole configuration to "$1" with the peer whose key
# is "$2" removed, and, when "$3" is a Device address, that peer appended fresh.
# Every other line of the file survives verbatim, so directives this helper does
# not understand are carried across untouched. Adding a key that is already
# present rewrites its one block rather than adding a second.
render_config() {
	rendered="$1"
	target_key="$2"
	new_address="${3:-}"

	: >"$rendered"
	in_peer=0
	block=''
	drop_block=0

	while IFS= read -r line || [ -n "$line" ]; do
		trim "$line"
		case "$trimmed" in
		'[Peer]')
			flush_block
			in_peer=1
			block="$line
"
			continue
			;;
		'['*']')
			flush_block
			in_peer=0
			printf '%s\n' "$line" >>"$rendered"
			continue
			;;
		esac
		if [ "$in_peer" -eq 0 ]; then
			printf '%s\n' "$line" >>"$rendered"
			continue
		fi
		case "$trimmed" in
		PublicKey*=*)
			trim "${trimmed#*=}"
			if [ "$trimmed" = "$target_key" ]; then
				drop_block=1
			fi
			;;
		esac
		block="$block$line
"
	done <"$config"
	flush_block

	if [ -n "$new_address" ]; then
		{
			printf '\n[Peer]\n'
			printf 'PublicKey = %s\n' "$target_key"
			printf 'AllowedIPs = %s/32\n' "$new_address"
		} >>"$rendered"
	fi
}

# flush_block writes the peer block gathered so far unless it is the one being
# replaced or removed.
flush_block() {
	if [ -n "$block" ] && [ "$drop_block" -eq 0 ]; then
		printf '%s' "$block" >>"$rendered"
	fi
	block=''
	drop_block=0
}

# apply_change renders the configuration with the change already made, asks the
# interface to accept it, and only then moves the rendered file into place. A
# refused `wg set` therefore leaves the configuration untouched, and a
# configuration this helper could not render is refused before the interface is
# asked for anything. "$1" is the peer's key, "$2" its Device address or empty
# for a removal, and the rest is the argument list for `wg set`.
apply_change() {
	peer_key="$1"
	peer_address="$2"
	shift 2

	pending="$config.nightloch-pending.$$"
	trap 'rm -f "$pending"' EXIT HUP INT TERM

	render_config "$pending" "$peer_key" "$peer_address"
	wg set "$interface" "$@"
	mv "$pending" "$config"

	trap - EXIT HUP INT TERM
}

cmd_add_peer() {
	validate_public_key "$1"
	validate_address "$2"
	require_config
	require_interface
	apply_change "$1" "$2" peer "$1" allowed-ips "$2/32"
}

cmd_remove_peer() {
	validate_public_key "$1"
	require_config
	require_interface
	apply_change "$1" '' peer "$1" remove
}

# cmd_show prints public key, allowed IPs, and latest handshake per peer. The
# first line of a dump describes the interface itself and carries its private
# key; it is read and discarded rather than reported.
cmd_show() {
	require_interface
	dump_output="$(wg show "$interface" dump)"
	printf '%s\n' "$dump_output" | {
		read -r _ || exit 0
		while read -r public_key _preshared_key _endpoint allowed_ips latest_handshake _rest; do
			printf '%s\t%s\t%s\n' "$public_key" "$allowed_ips" "$latest_handshake"
		done
	}
}

if [ $# -eq 0 ]; then
	refuse "no subcommand"
fi

subcommand="$1"
shift

case "$subcommand" in
add-peer)
	if [ $# -ne 2 ]; then
		refuse "add-peer takes a public key and an address"
	fi
	cmd_add_peer "$1" "$2"
	;;
remove-peer)
	if [ $# -ne 1 ]; then
		refuse "remove-peer takes a public key"
	fi
	cmd_remove_peer "$1"
	;;
show)
	if [ $# -ne 0 ]; then
		refuse "show takes no argument"
	fi
	cmd_show
	;;
*)
	refuse "unknown subcommand"
	;;
esac
