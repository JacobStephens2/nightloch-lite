# Public origin. Cookies are always Secure and host-only, so this must be HTTPS.
BASE_URL=https://lite.nightloch.app

# The service user needs read/write access to this directory.
DATABASE_PATH=/opt/nightloch/data/nightloch.db

# Keep the Go process private; Caddy is the only public HTTP listener.
HTTP_ADDR=127.0.0.1:8080

# Secrets belong in /etc/nightloch/nightloch.env (mode 0600), never in git.
RESEND_API_KEY=
RESEND_FROM="Nightloch <alerts@nightloch.app>"

# Signing secret for the Resend webhook that reports delivery, bounces, and
# complaints. Without it the app cannot authenticate a callback, so Partner
# reachability could never reflect anything but Nightloch's own send attempts.
# Resend dashboard -> Webhooks -> the https://<host>/webhooks/resend endpoint.
RESEND_WEBHOOK_SECRET=

TURNSTILE_SECRET_KEY=

# The Turnstile site key is public but deployment-specific.
TURNSTILE_SITE_KEY=
