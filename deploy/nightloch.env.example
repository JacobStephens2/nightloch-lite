# Public origin. Cookies are always Secure and host-only, so this must be HTTPS.
BASE_URL=https://lite.nightloch.app

# The service user needs read/write access to this directory.
DATABASE_PATH=/opt/nightloch/data/nightloch.db

# Keep the Go process private; Caddy is the only public HTTP listener.
HTTP_ADDR=127.0.0.1:8080

# Secrets belong in /etc/nightloch/nightloch.env (mode 0600), never in git.
RESEND_API_KEY=
RESEND_FROM="Nightloch <alerts@nightloch.app>"

# Signing secret for the Resend webhook that reports delivery, bounces, and
# complaints. Without it the app cannot authenticate a callback, so Partner
# reachability could never reflect anything but Nightloch's own send attempts.
# Resend dashboard -> Webhooks -> the https://<host>/webhooks/resend endpoint.
RESEND_WEBHOOK_SECRET=

TURNSTILE_SECRET_KEY=

# The Turnstile site key is public but deployment-specific.
TURNSTILE_SITE_KEY=

# The server side of the tunnel, as a minted Device's configuration states it.
# The endpoint is the published hostname rather than the droplet's address so
# the droplet can be rebuilt without invalidating a Device already installed on
# a phone. TUNNEL_ENDPOINT_PORT defaults to 51820, the port Slice 1's cloud
# firewall already opens.
TUNNEL_ENDPOINT_HOST=vpn.nightloch.app
TUNNEL_ENDPOINT_PORT=51820

# The wg0 interface's own public key: `wg show wg0 public-key` on the droplet.
# Only the public half. The interface's private key stays in
# /etc/wireguard/wg0.conf, which only root reads.
TUNNEL_PUBLIC_KEY=

# AdGuard Home's administration endpoint, which /health reads to report
# whether the resolver is reachable and filtering. ADGUARD_URL defaults to the
# loopback address AdGuard Home listens on; the app talks to it directly rather
# than through the Caddy site that fronts it for an Operator. Plain HTTP is
# accepted only to loopback, because these are AdGuard Home's full admin
# credentials rather than a scoped token (docs/SECURITY-POLICY-DESIGN.md §4).
ADGUARD_URL=http://127.0.0.1:3000
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
