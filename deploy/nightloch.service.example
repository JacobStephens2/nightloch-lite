# Paths: binary + data under /opt/nightloch, not under a web root (S5).
# Static assets only under /var/www/nightloch.app/public if needed.
# Run `/opt/nightloch/bin/nightloch migrate` as an explicit deploy step before
# starting a binary with new migrations. The service never auto-migrates.

[Unit]
Description=Nightloch Lite control plane
After=network.target

[Service]
Type=simple
User=nightloch
WorkingDirectory=/opt/nightloch
EnvironmentFile=/etc/nightloch/nightloch.env
ExecStart=/opt/nightloch/bin/nightloch serve
Restart=on-failure
RestartSec=3
UMask=0077

# Hardening. NoNewPrivileges must stay off: the app reaches the tunnel only by
# invoking /usr/local/sbin/nightloch-wg under sudo, and sudo cannot raise
# privilege with it set. The narrow grant in nightloch-wg.sudoers, and the
# helper's own closed subcommand surface, are what bound that escalation.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/nightloch

[Install]
WantedBy=multi-user.target
